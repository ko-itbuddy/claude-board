#!/bin/bash
# Claude Board 설치 후 처리 — Installer 가 root 로 실행한다
# 사용자별 설정(~/.claude·hook·명령·자동 실행)은 설치한 사용자 권한으로 user-setup.sh 가 맡는다 — root 소유 파일이 홈에 남지 않게
APP="/Applications/Claude Board.app"
xattr -dr com.apple.quarantine "$APP" 2>/dev/null || true

U="$(stat -f%Su /dev/console)"
case "$U" in ""|root|loginwindow) U="$USER" ;; esac
if [ -z "$U" ] || [ "$U" = root ]; then
  echo "Claude Board: 로그인한 사용자를 찾지 못해 사용자 설정을 건너뜁니다"
  exit 0
fi
UID_="$(id -u "$U")"
launchctl asuser "$UID_" sudo -u "$U" -H /bin/bash "$(dirname "$0")/user-setup.sh" "$APP"
